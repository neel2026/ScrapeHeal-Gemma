# Optional local API configuration. Copy to ignored .env and add your Gemma API key(s).
# Key 2 is a backup from a second Google AI Studio account; it is tried if a request with key 1 fails.
# Both attempts count toward ScrapeHeal's request and token guards.
GEMMA_API_KEY_1=
GEMMA_API_KEY_2=

# Default model; the app and CLI only allow the two documented Gemma 4 models.
GEMMA_MODEL=gemma-4-26b-a4b-it
